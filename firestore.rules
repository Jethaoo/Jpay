rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsGroup(groupId) {
      return signedIn() &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy;

      match /expenses/{expenseId} {
        allow read, create, update, delete: if ownsGroup(groupId);
      }
    }
  }
}
