# Client-safe values used by Flutter --dart-define.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-side migration values. Never pass these to Flutter.
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/firebase-service.json
